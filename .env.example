# C S G Estates — Environment Configuration
# Copy this file to .env or .env.local to configure your production credentials

# Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console:
# 1. Visit https://console.cloud.google.com/apis/credentials
# 2. Click "Create Credentials" -> "OAuth client ID" -> "Web application"
# 3. Add your domain / http://localhost:5173 to Authorized JavaScript origins
# 4. Paste your Client ID below:
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
